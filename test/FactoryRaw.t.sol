pragma solidity 0.8.24;
import "forge-std/Test.sol";
interface IAgentTip { function tip(address recipient, string calldata message) external payable; function totalReceived(address a) external view returns (uint256); }
contract FactoryRawTest is Test {
    address constant FACTORY = 0x914d7Fec6aaC8cd542e72Bca78B30650d45643d7;
    address constant NYCTO = 0x0d8C5bEe45EF5816856448A338aA12fE5281Fe9a;
    address constant LUQIA = 0xD452E84A2CaF0798aB81e97D8FeCECed144D0aED;
    address constant EXPECTED = 0x2ecA02A56cF51928ED7d790a0F4d8cC745C2e893;
    bytes constant INIT = hex"";
    function testFactoryRawDeploy() public {
        vm.deal(NYCTO, 1 ether);
        bytes memory data = abi.encodePacked(bytes32(0), INIT);
        vm.prank(NYCTO);
        uint256 gasBefore = gasleft();
        (bool ok, bytes memory ret) = FACTORY.call(data);
        uint256 gasUsed = gasBefore - gasleft();
        assertTrue(ok, "factory call failed");
        assertEq(ret, abi.encodePacked(EXPECTED), "returned address != CREATE2 prediction");
        assertGt(EXPECTED.code.length, 0, "no code at deployed address");
        emit log_named_uint("gas used (factory deploy)", gasUsed);
        emit log_named_address("deployed at", EXPECTED);
        vm.prank(NYCTO);
        IAgentTip(EXPECTED).tip{value: 0.0001 ether}(LUQIA, "factory raw deploy test");
        assertEq(IAgentTip(EXPECTED).totalReceived(LUQIA), 0.0001 ether);
    }
}
